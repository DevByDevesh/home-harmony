// HouseProvider.in ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â PostgreSQL schema (Backend Phase 1: foundation only).
// Mirrors domain terms in src/lib/admin/types.ts, src/lib/catalog.ts, src/lib/visits.ts.
// Rules: listing status and verification status are separate; featured never implies
// verification or quality; audit/payment/history rows use Restrict/SetNull, never cascade away.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum Role {
  USER
  OWNER
  AGENT
  PROPERTY_MANAGER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

enum AuthProvider {
  EMAIL
  PHONE_OTP
  GOOGLE
}

enum ListingType {
  RENT
  BUY
}

enum PropertyType {
  APARTMENT
  HOUSE
  ROOM
  PG
  COMMERCIAL
}

enum Furnishing {
  FULLY_FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum PromotionType {
  FEATURED
  BOOST
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  REJECTED
  SUSPENDED
  PAUSED
  RENTED
  SOLD
  EXPIRED
  DELETED
  ARCHIVED
}

enum VerificationStatus {
  NOT_REQUESTED
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum VerificationType {
  OWNER_IDENTITY
  PHONE
  LOCATION
  PROPERTY
  PHOTOS
  AVAILABILITY
  AGENT
}

enum VerificationReviewStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum ImageType {
  PHOTO
  FLOOR_PLAN
  DOCUMENT_PREVIEW
  OTHER
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum VisitStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReportCategory {
  FAKE_LISTING
  INCORRECT_INFORMATION
  DUPLICATE_LISTING
  SUSPICIOUS_ACTIVITY
  HARASSMENT
  SPAM
  PAYMENT_ISSUE
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PlanAudience {
  ALL
  OWNER
  AGENT
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  DEMO
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethodType {
  UPI
  CARD
  NETBANKING
  WALLET
}

enum RefundStatus {
  REQUESTED
  PROCESSED
  REJECTED
}

enum TransactionKind {
  CHARGE
  REFUND
}

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PricingModel {
  FIXED
  QUOTE
  HOURLY
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  ACCOUNT
  LISTING
  PAYMENT
  ABUSE
  TECHNICAL
  OTHER
}

enum OwnerContactRequestType {
  PHONE
  CALL
}

enum OwnerContactRequestStatus {
  REQUESTED
  ACCEPTED
  REJECTED
}

enum ServiceRequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------- Users & profiles ----------
model User {
  id             String        @id @default(cuid())
  email          String?       @unique
  phone          String?       @unique
  role           Role          @default(USER)
  /// Owner-controlled granular permissions for ADMIN/SUPER_ADMIN accounts. Null means role defaults.
  adminPermissions Json?
  status         AccountStatus @default(PENDING)
  /// Display name used by the auth library (profile keeps the canonical fullName).
  name           String        @default("")
  image          String?
  /// Boolean flag required by the auth library; `emailVerified` keeps the timestamp.
  emailConfirmed Boolean       @default(false)
  emailVerified  DateTime?
  phoneVerified  DateTime?
  /// Earned when the one-time six-month promotional offer is successfully claimed.
  verifiedBadge  Boolean       @default(false)
  lastActiveAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  authAccounts             AuthAccount[]
  sessions                 Session[]
  profile                  Profile?
  ownerProfile             OwnerProfile?
  agentProfile             AgentProfile?
  ownedProperties          Property[]        @relation("PropertyOwner")
  agentProperties          Property[]        @relation("PropertyAgent")
  savedProperties          SavedProperty[]
  savedSearches            SavedSearch[]
  searchPreference         SearchPreference?
  comparisons              Comparison[]
  visits                   Visit[]           @relation("VisitRequester")
  handledVisits            Visit[]           @relation("VisitHandler")
  enquiries                Enquiry[]         @relation("EnquiryRequester")
  handledEnquiries         Enquiry[]         @relation("EnquiryHandler")
  notifications            Notification[]
  verifications            Verification[]    @relation("VerificationSubject")
  reviewedVerifs           Verification[]    @relation("VerificationReviewer")
  reportsFiled             Report[]          @relation("Reporter")
  reportsAbout             Report[]          @relation("ReportSubject")
  reportsAssigned          Report[]          @relation("ReportAssignee")
  auditLogs                AuditLog[]
  subscriptions            Subscription[]
  payments                 Payment[]
  serviceProvider          ServiceProvider?
  serviceRequests          ServiceRequest[]
  supportTickets            SupportTicket[] @relation("SupportTicketRequester")
  assignedSupportTickets    SupportTicket[] @relation("SupportTicketAssignee")
  propertyReviews          PropertyReview[]
  featuredCreated          FeaturedListing[]
  buyerConversations       Conversation[]    @relation("ConversationBuyer")
  participantConversations Conversation[]    @relation("ConversationParticipant")
  sentMessages             Message[]         @relation("MessageSender")
  contactRequestsMade       OwnerContactRequest[] @relation("OwnerContactRequester")
  contactRequestsReceived   OwnerContactRequest[] @relation("OwnerContactOwner")

  @@index([role])
  @@index([status])
}

/// Auth-provider linkage prepared for the auth phase. No password hashes are stored here yet.
/// Auth-provider linkage used by Better Auth (credential passwords are stored hashed here, never plain text).
model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  /// "credential" for email+password, "google" later. Kept as text because the auth library owns the values.
  providerId            String
  providerAccountId     String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerAccountId])
  @@index([userId])
}

/// Server-side session. The browser only holds a signed, HttpOnly cookie referencing `token`.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Email verification / password reset tokens (no email provider connected yet).
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Shared rate-limit counters so limits hold across server instances.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String?
  avatarKey String?
  city      String?
  locale    String   @default("en-IN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  bio                String?
  contactPhone       String?
  contactEmail       String?
  preferredContact   String?
  verificationStatus VerificationStatus @default(NOT_REQUESTED)
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  agency             String?
  licenseNumber      String?
  licenseAuthority   String?
  bio                String?
  contactPhone       String?
  contactEmail       String?
  verificationStatus VerificationStatus @default(NOT_REQUESTED)
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Properties ----------
model Property {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  description        String
  propertyType       PropertyType
  listingType        ListingType
  price              Int // INR; sale price for BUY, monthly rent for RENT
  deposit            Int?
  brokerage          String?
  areaSqft           Int
  bedrooms           Int
  bathrooms          Int
  parking            Int                @default(0)
  propertyAgeYears   Int?
  floor              Int?
  totalFloors        Int?
  furnishing         Furnishing
  availableFrom      DateTime?
  city               String
  locality           String
  addressLine1       String?
  addressLine2       String?
  pincode            String?
  state              String?
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  status             PropertyStatus     @default(UNDER_REVIEW)
  verificationStatus VerificationStatus @default(NOT_REQUESTED)
  changesRequested   String?
  ownerId            String
  agentId            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  publishedAt        DateTime?

  owner           User                 @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  agent           User?                @relation("PropertyAgent", fields: [agentId], references: [id], onDelete: SetNull)
  images          PropertyImage[]
  amenities       PropertyAmenity[]
  savedBy         SavedProperty[]
  comparisons     ComparisonProperty[]
  visits          Visit[]
  enquiries       Enquiry[]
  verifications   Verification[]
  reports         Report[]
  featured        FeaturedListing[]
  serviceRequests ServiceRequest[]
  reviews         PropertyReview[]
  conversations   Conversation[]
  contactRequests OwnerContactRequest[]

  @@index([city])
  @@index([locality])
  @@index([status])
  @@index([verificationStatus])
  @@index([listingType])
  @@index([propertyType])
  @@index([price])
  @@index([createdAt])
  @@index([ownerId])
  @@index([agentId])
  @@index([city, listingType, status])
}

/// Stores a storage key/URL only ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â never binary data.
model PropertyReview {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([propertyId, userId])
  @@index([propertyId, createdAt])
  @@index([userId])
}

model PropertyImage {
  id         String    @id @default(cuid())
  propertyId String
  storageKey String
  url        String?
  type       ImageType @default(PHOTO)
  altText    String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  slug       String            @unique
  category   String?
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

// ---------- Seeker data ----------
model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

/// `criteria` holds the app's `Filters` object as JSON so new filters need no migration.
model SavedSearch {
  id             String         @id @default(cuid())
  userId         String
  name           String
  criteria       Json
  alertEnabled   Boolean        @default(false)
  alertFrequency AlertFrequency @default(DAILY)
  alertTypes     Json?
  lastNotifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Only values the user sets; all optional, nothing inferred.
model SearchPreference {
  id            String         @id @default(cuid())
  userId        String         @unique
  budgetMin     Int?
  budgetMax     Int?
  cities        String[]
  localities    String[]
  listingType   ListingType?
  propertyTypes PropertyType[]
  bedrooms      Int[]
  furnishing    Furnishing[]
  amenitySlugs  String[]
  moveInFrom    DateTime?
  extra         Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Max 4 properties enforced at application level (COMPARE_LIMIT). No ranking stored.
model Comparison {
  id         String               @id @default(cuid())
  userId     String
  name       String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties ComparisonProperty[]

  @@index([userId])
}

model ComparisonProperty {
  comparisonId String
  propertyId   String
  position     Int
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([comparisonId, propertyId])
  @@unique([comparisonId, position])
}

model Visit {
  id            String      @id @default(cuid())
  userId        String
  propertyId    String
  handlerId     String?
  requestedDate DateTime    @db.Date
  requestedTime String
  confirmedAt   DateTime?
  notes         String?
  status        VisitStatus @default(REQUESTED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation("VisitRequester", fields: [userId], references: [id], onDelete: Restrict)
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  handler       User?       @relation("VisitHandler", fields: [handlerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requestedDate])
  @@index([userId])
  @@index([propertyId])
  @@index([handlerId])
}

model Enquiry {
  id             String        @id @default(cuid())
  userId         String
  propertyId     String
  handlerId      String?
  message        String
  channel        String        @default("IN_APP")
  status         EnquiryStatus @default(NEW)
  notes          Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastActivityAt DateTime      @default(now())
  user           User          @relation("EnquiryRequester", fields: [userId], references: [id], onDelete: Restrict)
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  handler        User?         @relation("EnquiryHandler", fields: [handlerId], references: [id], onDelete: SetNull)
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([status])
  @@index([propertyId])
  @@index([handlerId])
  @@index([userId])
}

/// Storage only ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â no email/SMS/push provider is connected.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------- Trust ----------
model Verification {
  id          String                   @id @default(cuid())
  type        VerificationType
  status      VerificationReviewStatus @default(PENDING)
  userId      String
  propertyId  String?
  reviewerId  String?
  submittedAt DateTime                 @default(now())
  decidedAt   DateTime?
  expiresAt   DateTime?
  updatedAt   DateTime                 @updatedAt
  user        User                     @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Restrict)
  property    Property?                @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reviewer    User?                    @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  items       VerificationItem[]

  @@index([status])
  @@index([type, status])
  @@index([userId])
  @@index([propertyId])
}

/// Evidence reference (storage key) kept separate from the parent status.
model VerificationItem {
  id             String       @id @default(cuid())
  verificationId String
  label          String
  evidenceKey    String?
  evidenceType   String?
  note           String?
  createdAt      DateTime     @default(now())
  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

model Report {
  id            String         @id @default(cuid())
  category      ReportCategory
  status        ReportStatus   @default(OPEN)
  priority      Priority       @default(MEDIUM)
  summary       String
  reporterId    String
  subjectUserId String?
  propertyId    String?
  assigneeId    String?
  notes         Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resolvedAt    DateTime?
  reporter      User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  subjectUser   User?          @relation("ReportSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([propertyId])
}

/// Append-only. Application code exposes create/read only; revoke UPDATE/DELETE at DB level in production.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  result     String   @default("SUCCESS")
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([actorId])
}

// ---------- Commerce ----------
/// Prices are admin configuration, not final commercial pricing.
model SubscriptionPlan {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  description       String?
  audience          PlanAudience   @default(ALL)
  monthlyPrice      Int
  annualPrice       Int
  currency          String         @default("INR")
  active            Boolean        @default(true)
  features          Json?
  listingLimit      Int?
  featuredAllowance Int            @default(0)
  analyticsAccess   Boolean        @default(false)
  leadLimit         Int?
  teamSeats         Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subscriptions     Subscription[]
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  planId            String
  status            SubscriptionStatus @default(TRIAL)
  cycle             BillingCycle       @default(MONTHLY)
  startedAt         DateTime           @default(now())
  renewsAt          DateTime?
  cancelledAt       DateTime?
  provider          PaymentProvider    @default(DEMO)
  providerReference String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments          Payment[]

  @@index([status])
  @@index([userId])
}

/// Provider references only ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â no card numbers, UPI IDs or secrets.
model Payment {
  id                String             @id @default(cuid())
  userId            String
  subscriptionId    String?
  product           String
  amount            Int
  currency          String             @default("INR")
  status            PaymentStatus      @default(PENDING)
  provider          PaymentProvider    @default(DEMO)
  providerReference String?            @unique
  methodType        PaymentMethodType?
  methodLabel       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice           Invoice?
  refunds           Refund[]
  transactions      Transaction[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model Invoice {
  id        String   @id @default(cuid())
  paymentId String   @unique
  number    String   @unique
  issuedAt  DateTime @default(now())
  lines     Json
  tax       Int      @default(0)
  total     Int
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  amount            Int
  reason            String?
  status            RefundStatus @default(REQUESTED)
  providerReference String?
  requestedAt       DateTime     @default(now())
  processedAt       DateTime?
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
}

model Transaction {
  id                String          @id @default(cuid())
  paymentId         String
  kind              TransactionKind
  amount            Int
  providerReference String?
  createdAt         DateTime        @default(now())
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

/// Promotional placement only ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â independent of verification, match score, quality or safety.
/// Overlapping active windows per property are prevented in the service layer.
model FeaturedListing {
  id            String        @id @default(cuid())
  propertyId    String
  promotionType PromotionType @default(FEATURED)
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([propertyId, active])
  @@index([startsAt, endsAt])
}

// ---------- Customer support ----------
model OwnerContactRequest {
  id               String                     @id @default(cuid())
  requesterId      String
  ownerId          String
  propertyId       String
  conversationId   String?
  type             OwnerContactRequestType
  status           OwnerContactRequestStatus @default(REQUESTED)
  preferredDate    DateTime?                @db.Date
  preferredTime    String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  decidedAt        DateTime?

  requester        User         @relation("OwnerContactRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner            User         @relation("OwnerContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  property         Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([requesterId, createdAt])
  @@index([ownerId, status, createdAt])
  @@index([propertyId, type, status])
  @@index([conversationId])
}

model SupportTicket {
  id          String             @id @default(cuid())
  userId      String
  assigneeId  String?
  category    SupportTicketCategory
  subject     String
  description String
  attachments Json?
  priority    Priority           @default(MEDIUM)
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  resolvedAt  DateTime?
  user        User               @relation("SupportTicketRequester", fields: [userId], references: [id], onDelete: Restrict)
  assignee    User?              @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, priority])
  @@index([assigneeId, status])
}

// ---------- Services marketplace ----------
model ServiceCategory {
  id            String            @id @default(cuid())
  name          String            @unique
  slug          String            @unique
  enabled       Boolean           @default(true)
  commissionPct Decimal           @default(0) @db.Decimal(5, 2)
  providers     ServiceProvider[]
  requests      ServiceRequest[]
}

/// `rating` stays null until genuine reviews exist.
model ServiceProvider {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  name               String
  business           String
  categoryId         String
  city               String
  contact            String?
  verificationStatus VerificationStatus @default(NOT_REQUESTED)
  rating             Decimal?           @db.Decimal(2, 1)
  status             ProviderStatus     @default(PENDING)
  services           String[]
  pricingModel       PricingModel       @default(QUOTE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  category           ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requests           ServiceRequest[]
  bookings           ServiceBooking[]

  @@index([categoryId, status])
  @@index([city])
}

model ServiceRequest {
  id         String               @id @default(cuid())
  userId     String
  categoryId String
  propertyId String?
  providerId String?
  city       String
  notes      String?
  status     ServiceRequestStatus @default(NEW)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  category   ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  property   Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  provider   ServiceProvider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  booking    ServiceBooking?

  @@index([status])
  @@index([userId])
  @@index([providerId])
}

/// A booking exists once a provider is assigned and a slot agreed.
model ServiceBooking {
  id           String               @id @default(cuid())
  requestId    String               @unique
  providerId   String
  scheduledFor DateTime
  status       ServiceRequestStatus @default(ASSIGNED)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  request      ServiceRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  provider     ServiceProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, scheduledFor])
  @@index([status])
}

model Conversation {
  id            String    @id @default(cuid())
  propertyId    String
  buyerId       String
  participantId String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer       User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  participant User      @relation("ConversationParticipant", fields: [participantId], references: [id], onDelete: Restrict)
  messages    Message[]
  enquiries   Enquiry[]
  contactRequests OwnerContactRequest[]

  @@unique([propertyId, buyerId, participantId])
  @@index([buyerId, lastMessageAt])
  @@index([participantId, lastMessageAt])
  @@index([propertyId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@index([senderId])
}


model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
