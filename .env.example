# Server-only. PostgreSQL connection string for Prisma. Never expose to the browser
# (do NOT prefix with VITE_). Set the real value in the hosting secret store, not in git.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Better Auth signing secret (server-only; never VITE_). Required by the auth server.
# Generate a long random value and set it in the hosting secret store, not in git.
BETTER_AUTH_SECRET=""

# Optional comma-separated additional trusted browser origins for Better Auth.
# The built-in production + staging origins are already allowlisted; use this for additional environments.
BETTER_AUTH_TRUSTED_ORIGINS=""
# Staging auth base URL (set this on staging only; never point staging at production).
# BETTER_AUTH_URL="https://staging.houseprovider.in"

# Password reset email delivery via Resend (server-only; never VITE_). Use a verified sender/domain.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="HouseProvider <no-reply@houseprovider.in>"

# Google OAuth for "Continue with Google" (server-only; never VITE_). Both must be set together;
# when unset, Google sign-in stays disabled and email/password keeps working.
# Register the redirect URI "{BETTER_AUTH_URL}/api/auth/callback/google" in the Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# One-time first Super admin bootstrap (server-only; never VITE_). Set a 24+ char value in the secret manager.
SUPER_ADMIN_BOOTSTRAP_SECRET=""
# Set to "false" to switch the bootstrap off (it also locks itself after one successful use).
SUPER_ADMIN_BOOTSTRAP_ENABLED=""

# Public Mapbox token for browser maps and staging place search. Safe to expose to the browser when prefixed VITE_.
VITE_MAPBOX_PUBLIC_TOKEN=""

# Property photo storage (server-only; never VITE_*)
STORAGE_SUPABASE_URL=
STORAGE_SUPABASE_SERVICE_KEY=

# Marketplace safety review is deterministic and server-side; no paid AI API key is required.
